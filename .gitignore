# Build output (make / g++)
/led
/virtual-strip
*.o
*.d

# ESP-IDF firmware build output (idf.py writes a per-target build dir), pulled
# managed components, the generated sdkconfig (sdkconfig.defaults is tracked),
# and prebuilt images downloaded by `make flash`
firmware/build/
firmware/build-*/
firmware/managed_components/
firmware/sdkconfig
firmware/sdkconfig.old
firmware/dependencies.lock
firmware/dist/

# leftover from the old arduino-cli flow (common headers were mirrored here)
firmware/src/

# Python bytecode (tools/pincheck.py is imported by the config encoders)
__pycache__/

# Editor / IDE
.idea/
.vscode/
*.swp
*~

# OS cruft
.DS_Store

# hardware/bc250_carrier: regenerable exports (make export) and KiCad's own scratch files
hardware/bc250_carrier/out/
hardware/bc250_carrier/*-backups/
hardware/bc250_carrier/fp-info-cache
hardware/bc250_carrier/*.kicad_prl
hardware/bc250_carrier/*.lck
hardware/bc250_carrier/__pycache__/
