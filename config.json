{
    "serial": {
        "port": "/dev/ttyUSB0",
        "baud": 921600,
        "host_timeout_ms": 5000
    },
    "strip": {
        "leds": 58,
        "pin": 13,
        "brightness": 0.2,
        "gamma": "2.2",
        "white_balance": "b4ffff"
    },
    "sensors": [
        "k10temp:Tctl",
        "nct6686:CPU",
        "nct6687:CPU",
        "nct6686:AMD TSI Addr 98h",
        "nct6683:AMD TSI Addr 98h",
        "nct6686"
    ],
    "esp32": {
        "power_on": {
            "effect": "boot",
            "settings": {
                "duration_seconds": 5
            }
        },
        "shutdown": {
            "effect": "shutdown",
            "settings": {
                "color": "0028ff",
                "duration_seconds": 1.5
            }
        }
    },
    "rules": [
        {
            "if": "temp>85",
            "effect": "alarm",
            "hold": 0,
            "settings": {
                "pulses_per_second": 2
            }
        },
        {
            "if": "file:/tmp/led-rainbow",
            "effect": "rainbow",
            "hold": 0,
            "settings": {
                "cycles_per_second": 0.625
            }
        },
        {
            "if": "file:/tmp/led-night",
            "effect": "twinkle",
            "hold": 0,
            "settings": {
                "color": "ffffff",
                "base_color": "000020",
                "sparks_per_second": 6,
                "fade_seconds": 1.0
            }
        },
        {
            "if": "steam_dl",
            "effect": "steam_download",
            "hold": 0
        },
        {
            "if": "gpu_load>20 | cpu_load>20",
            "effect": "load",
            "hold": 0,
            "settings": {
                "smoothing_seconds": 0.5
            }
        },
        {
            "if": "proc:gamescope & temp>75 | proc:steam & temp>75",
            "effect": "fire",
            "hold": 0,
            "settings": {
                "speed": 1.6,
                "min_heat": 0.45
            }
        },
        {
            "if": "proc:gamescope | proc:steam",
            "effect": "fire",
            "hold": 0,
            "settings": {
                "speed": 1.0,
                "min_heat": 0.25
            }
        },
        {
            "if": "temp>65",
            "effect": "cpu_temp",
            "hold": 0,
            "settings": {
                "temp_min": 40,
                "temp_max": 85
            }
        },
        {
            "if": "temp<48",
            "effect": "aurora",
            "hold": 0,
            "settings": {
                "speed": 1.0,
                "hue_min": 0.3,
                "hue_max": 0.85
            }
        },
        {
            "effect": "cycle",
            "hold": 0,
            "settings": {
                "period_seconds": 30,
                "effects": [
                    {
                        "effect": "breathe",
                        "settings": {
                            "color": "ff7818",
                            "period_seconds": 5,
                            "min_brightness": 0.05
                        }
                    },
                    {
                        "effect": "aurora",
                        "settings": {
                            "speed": 1.0,
                            "hue_min": 0.3,
                            "hue_max": 0.85
                        }
                    },
                    {
                        "effect": "twinkle",
                        "settings": {
                            "color": "ffffff",
                            "base_color": "000020",
                            "sparks_per_second": 6,
                            "fade_seconds": 1.0
                        }
                    },
                    {
                        "effect": "comet",
                        "seconds": 20,
                        "settings": {
                            "color": "00ffaa",
                            "sweeps_per_second": 0.5,
                            "tail_pixels": 8
                        }
                    }
                ]
            }
        }
    ]
}
