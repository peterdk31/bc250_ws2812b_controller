{
    "serial": {
        "port": "/dev/ttyUSB0",
        "baud": 921600,
        "host_timeout_ms": 5000
    },
    "strip": {
        "leds": 26,
        "pin": 13,
        "reverse": false,
        "brightness": 1.0,
        "gamma": "1.9 1.8 1.7",
        "white_balance": "b4ffff"
    },
    "transition_seconds": 0.6,
    "sensors": [
        "k10temp:Tctl",
        "nct6686:CPU",
        "nct6687:CPU",
        "nct6686:AMD TSI Addr 98h",
        "nct6683:AMD TSI Addr 98h",
        "nct6686"
    ],
    "esp32": {
        "power_on": {
            "effect": "boot",
            "settings": {
                "intro_seconds": 3
            }
        },
        "shutdown": {
            "effect": "shutdown",
            "settings": {
                "color": "0028ff",
                "duration_seconds": 5.0
            }
        }
    },
    "rules": [
        {
            "if": "temp>85",
            "effect": "alarm",
            "hold": 0,
            "settings": {
                "pulses_per_second": 2
            }
        },
        {
            "if": "file:/tmp/led-rainbow",
            "effect": "rainbow",
            "hold": 0,
            "settings": {
                "cycles_per_second": 0.625
            }
        },
        {
            "if": "file:/tmp/led-night",
            "effect": "drift",
            "hold": 0,
            "settings": {
                "color": "6078ff",
                "base_color": "000014",
                "blobs": 3,
                "width": 0.10,
                "speed": 1.0
            }
        },
        {
            "if": "steam_dl",
            "effect": "steam_download",
            "hold": 0
        },
        {
            "if": "gpu_load>20 | cpu_load>20",
            "effect": "load",
            "hold": 0,
            "settings": {
                "smoothing_seconds": 0.7,
                "palette": "00e0c0,2060ff,a040ff",
                "speed": 1.0
            }
        },
        {
            "if": "proc:gamescope & temp>75 | proc:steam & temp>75",
            "effect": "ember",
            "hold": 0,
            "settings": {
                "palette": "3a0a00,ff5a0a,ffb030",
                "speed": 1.4,
                "min_brightness": 0.35
            }
        },
        {
            "if": "proc:gamescope | proc:steam",
            "effect": "ember",
            "hold": 0,
            "settings": {
                "palette": "2a0a00,ff7d1e",
                "speed": 1.0,
                "min_brightness": 0.18
            }
        },
        {
            "if": "temp>65",
            "effect": "cpu_temp",
            "hold": 0,
            "settings": {
                "temp_min": 40,
                "temp_max": 85
            }
        },
        {
            "if": "temp<48",
            "effect": "aurora",
            "hold": 0,
            "settings": {
                "speed": 1.0,
                "palette": "10ff80,10a0ff,8040ff"
            }
        },
        {
            "effect": "cycle",
            "hold": 0,
            "settings": {
                "period_seconds": 30,
                "effects": [
                    {
                        "effect": "breathe",
                        "settings": {
                            "color": "ff7818",
                            "period_seconds": 5,
                            "min_brightness": 0.05
                        }
                    },
                    {
                        "effect": "aurora",
                        "settings": {
                            "speed": 1.0,
                            "palette": "10ff80,10a0ff,8040ff"
                        }
                    },
                    {
                        "effect": "drift",
                        "settings": {
                            "color": "6078ff",
                            "base_color": "000014",
                            "blobs": 3,
                            "width": 0.10,
                            "speed": 1.0
                        }
                    },
                    {
                        "effect": "plasma",
                        "settings": {
                            "palette": "0040ff,00d0a0,c040ff,0040ff",
                            "speed": 1.0
                        }
                    },
                    {
                        "effect": "tide",
                        "settings": {
                            "palette": "102060,ff5028,ffb020,4060c0,102060",
                            "speed": 1.0,
                            "span": 1.0
                        }
                    },
                    {
                        "effect": "pulse",
                        "settings": {
                            "color": "30c0ff",
                            "base_color": "000010",
                            "period_seconds": 4,
                            "width": 0.18,
                            "travel": 1.4
                        }
                    },
                    {
                        "effect": "comet",
                        "seconds": 20,
                        "settings": {
                            "color": "00ffaa",
                            "sweeps_per_second": 0.5,
                            "tail_pixels": 8,
                            "turn_ease": 1.0,
                            "mirror": 1
                        }
                    }
                ]
            }
        }
    ]
}
