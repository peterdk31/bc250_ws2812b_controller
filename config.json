{
    "sinks": {
        "serial": {
            "port": "/dev/led-controller",
            "baud": 921600
        }
    },
    "strip": {
        "leds": 26,
        "pin": 13,
        "reverse": false,
        "brightness": 1.0,
        "gamma": "2.2",
        "white_balance": "ffb0f0"
    },
    "crossfade_ms": 600,
    "frame_ms": 16,
    "sensors": [
        "k10temp:Tctl",
        "nct6686:CPU",
        "nct6687:CPU",
        "nct6686:AMD TSI Addr 98h",
        "nct6683:AMD TSI Addr 98h",
        "nct6686"
    ],
    "esp32": {
        "target": "esp32c3",
        "host_timeout_ms": 5000,
        "power_on": {
            "sequence": [
                {
                    "effect": "button_on",
                    "record_seconds": 4.5,
                    "settings": {
                        "reverse": true,
                        "color": "ffffff",
                        "spread_seconds": 2.5,
                        "period_seconds": 4,
                        "min_brightness": 0.05
                    }
                },
                {
                    "effect": "breathe",
                    "record_seconds": 5,
                    "loop": true,
                    "settings": {
                        "palette": "ffffff",
                        "period_seconds": 5,
                        "min_brightness": 0.05
                    }
                }
            ]
        },
        "shutdown": {
            "effect": "button_off",
            "settings": {
                "reverse": true,
                "color": "ffffff",
                "duration_seconds": 1.4
            }
        }
    },
    "rules": [
        {
            "if": "temp>85",
            "effect": "alarm",
            "hold": 0,
            "settings": {
                "pulses_per_second": 2
            }
        },
        {
            "if": "file:/tmp/led-rainbow",
            "effect": "rainbow",
            "hold": 0
        },
        {
            "if": "file:/tmp/led-night",
            "effect": "drift",
            "hold": 0,
            "settings": {
                "palette": "6078ff",
                "base_color": "000014",
                "blobs": 3,
                "width": 0.10
            }
        },
        {
            "if": "steam_dl",
            "effect": "steam_download",
            "hold": 0,
            "settings": {
                "palette": "d4009c,ff5a1e,ffd23c",
                "head_color": "fff2cc",
                "track_color": "0e1c3c",
                "speed": 1.0,
                "ripple_depth": 0.35,
                "ripple_speed": 1.4,
                "surge_boost": 0.45,
                "surge_ripple": 0.9,
                "head_glow": 0.7
            }
        },
        {
            "if": "gpu_load>20 | cpu_load>20",
            "effect": "load",
            "hold": 0,
            "settings": {
                "smoothing_seconds": 0.7,
                "palette": "00e0c0,2060ff,a040ff"
            }
        },
        {
            "if": "audio_playing",
            "effect": "cycle",
            "hold": 0,
            "settings": {
                "period_seconds": 40,
                "effects": [
                    {
                        "effect": "audio_music",
                        "settings": {
                            "palette": "4a00b4,e02090,ff9c28",
                            "glow_color": "ffffff",
                            "pulse": 0.8
                        }
                    },
                    {
                        "effect": "audio_ripple",
                        "settings": {
                            "palette": "0030a0,00c0e0,8040ff",
                            "glow_color": "ffffff",
                            "travel_seconds": 1.0
                        }
                    },
                    {
                        "effect": "audio_spectrum",
                        "settings": {
                            "palette": "00e6b4,3a56ff,ff2e88",
                            "peak_color": "ffffff"
                        }
                    }
                ]
            }
        },
        {
            "if": "proc:gamescope & temp>75 | proc:steam & temp>75",
            "effect": "ember",
            "hold": 0,
            "settings": {
                "palette": "3a0a00,ff5a0a,ffb030",
                "min_brightness": 0.35
            }
        },
        {
            "effect": "cycle",
            "hold": 0,
            "settings": {
                "period_seconds": 30,
                "effects": [
                    {
                        "effect": "breathe",
                        "settings": {
                            "palette": "0d4a44,30e090",
                            "min_brightness": 0.05
                        }
                    },
                    {
                        "effect": "aurora",
                        "settings": {
                            "speed": 1.0,
                            "palette": "10ff80,10a0ff,8040ff"
                        }
                    },
                    {
                        "effect": "drift",
                        "settings": {
                            "palette": "6078ff",
                            "base_color": "000014",
                            "blobs": 3,
                            "width": 0.10
                        }
                    },
                    {
                        "effect": "plasma",
                        "settings": {
                            "palette": "0040ff,00d0a0,c040ff,0040ff"
                        }
                    },
                    {
                        "effect": "lava",
                        "settings": {
                            "palette": "ff0050,ff5a00,ffd000,00e5ff,7a00ff,ff00d0",
                            "blobs": 4,
                            "radius": 0.2,
                            "speed": 5.0,
                            "color_speed": 1.0,
                            "color_span": 0.5,
                            "core": 1.6,
                            "white_hot": 2.5,
                            "min_brightness": 0.0
                        }
                    },
                    {
                        "effect": "tide",
                        "settings": {
                            "palette": "102060,1890d0,30d0a0,8040ff,102060",
                            "span": 1.0
                        }
                    },
                    {
                        "effect": "pulse",
                        "settings": {
                            "palette": "30c0ff",
                            "base_color": "000010",
                            "width": 0.18,
                            "travel": 1.4
                        }
                    },
                    {
                        "effect": "comet",
                        "seconds": 20,
                        "settings": {
                            "palette": "00ffaa",
                            "tail_pixels": 8,
                            "turn_ease": 1.0,
                            "mirror": 1
                        }
                    }
                ]
            }
        }
    ]
}
