{
    "sinks": {
        "serial": {
            "port": "/dev/led-controller",
            "baud": 921600
        }
    },
    "strip": {
        "leds": 33,
        "pin": 4,
        "reverse": false,
        "brightness": 1.0,
        "gamma": "2.2",
        "white_balance": "ffb0f0"
    },
    "crossfade_ms": 600,
    "frame_ms": 16,
    "sensors": [
        "k10temp:Tctl",
        "nct6686:CPU",
        "nct6687:CPU",
        "nct6686:AMD TSI Addr 98h",
        "nct6683:AMD TSI Addr 98h",
        "nct6686"
    ],
    "esp32": {
        "target": "esp32c3",
        "host_timeout_ms": 5000,
        "power_on": {
            "sequence": [
                {
                    "effect": "button_on",
                    "record_seconds": 4.5,
                    "settings": {
                        "origin": 0.5,
                        "palette": "ff0000,ff8000,ffff00,00c000,0060ff,8000ff",
                        "spread_seconds": 2.5,
                        "period_seconds": 4,
                        "min_brightness": 0.05
                    }
                },
                {
                    "effect": "breathe",
                    "record_seconds": 5,
                    "loop": true,
                    "settings": {
                        "palette": "ffffff",
                        "period_seconds": 5,
                        "min_brightness": 0.05
                    }
                }
            ]
        },
        "shutdown": {
            "effect": "button_off",
            "settings": {
                "origin": 0.5,
                "palette": "ff0000,ff8000,ffff00,00c000,0060ff,8000ff",
                "duration_seconds": 1.4
            }
        }
    },
    "rules": [
        {
            "if": "temp>85",
            "effect": "alarm",
            "hold": 0,
            "settings": {
                "pulses_per_second": 2
            }
        },
        {
            "if": "file:/tmp/led-rainbow",
            "effect": "rainbow",
            "hold": 0
        },
        {
            "if": "file:/tmp/led-night",
            "effect": "drift",
            "hold": 0,
            "settings": {
                "palette": "6078ff",
                "base_color": "000014",
                "blobs": 3,
                "width": 0.10
            }
        },
        {
            "if": "steam_dl",
            "effect": "steam_download",
            "hold": 0,
            "settings": {
                "palette": "d4009c,ff5a1e,ffd23c",
                "head_color": "fff2cc",
                "track_color": "0e1c3c",
                "speed": 1.0,
                "ripple_depth": 0.35,
                "ripple_speed": 1.4,
                "surge_boost": 0.45,
                "surge_ripple": 0.9,
                "head_glow": 0.7
            }
        },
        {
            "if": "gpu_load>20 | cpu_load>20",
            "effect": "cycle",
            "hold": 0,
            "settings": {
                "period_seconds": 120,
                "effects": [
                    {
                        "effect": "load",
                        "settings": {
                            "smoothing_seconds": 0.7,
                            "palette": "00e0c0,2060ff,a040ff,ff4060,ff9000",
                            "heat_span": 0.45,
                            "color_drift": 0.3
                        }
                    },
                    {
                        "effect": "load_boil",
                        "settings": {
                            "smoothing_seconds": 0.7,
                            "palette": "00e0c0,2060ff,a040ff,ff4060,ff9000",
                            "blobs": 2,
                            "radius": 0.3,
                            "boil": 2.5
                        }
                    }
                ]
            }
        },
        {
            "if": "audio_playing",
            "effect": "cycle",
            "hold": 0,
            "settings": {
                "period_seconds": 40,
                "effects": [
                    {
                        "effect": "audio_music",
                        "settings": {
                            "palette": "4a00b4,e02090,ff9c28",
                            "glow_color": "ffffff",
                            "pulse": 0.8
                        }
                    },
                    {
                        "effect": "audio_ripple",
                        "settings": {
                            "palette": "0030a0,00c0e0,8040ff",
                            "glow_color": "ffffff",
                            "travel_seconds": 1.0
                        }
                    },
                    {
                        "effect": "audio_spectrum",
                        "settings": {
                            "palette": "00e6b4,3a56ff,ff2e88",
                            "peak_color": "ffffff"
                        }
                    }
                ]
            }
        },
        {
            "if": "proc:gamescope & temp>75 | proc:steam & temp>75",
            "effect": "ember",
            "hold": 0,
            "settings": {
                "palette": "3a0a00,ff5a0a,ffb030",
                "min_brightness": 0.35
            }
        },
        {
            "effect": "cycle",
            "hold": 0,
            "settings": {
                "period_seconds": 30,
                "effects": [
                    {
                        "effect": "breathe",
                        "settings": {
                            "palette": "0d4a44,30e090",
                            "min_brightness": 0.05
                        }
                    },
                    {
                        "effect": "aurora",
                        "settings": {
                            "speed": 1.0,
                            "palette": "10ff80,10a0ff,8040ff"
                        }
                    },
                    {
                        "effect": "drift",
                        "settings": {
                            "palette": "6078ff",
                            "base_color": "000014",
                            "blobs": 3,
                            "width": 0.10
                        }
                    },
                    {
                        "effect": "plasma",
                        "settings": {
                            "palette": "0040ff,00d0a0,c040ff,0040ff"
                        }
                    },
                    {
                        "effect": "lava",
                        "settings": {
                            "palette": "ff0050,ff5a00,ffd000,00e5ff,7a00ff,ff00d0",
                            "blobs": 4,
                            "radius": 0.2,
                            "speed": 5.0,
                            "color_speed": 1.0,
                            "color_span": 0.5,
                            "core": 1.6,
                            "white_hot": 2.5,
                            "min_brightness": 0.0
                        }
                    },
                    {
                        "effect": "tide",
                        "settings": {
                            "palette": "102060,1890d0,30d0a0,8040ff,102060",
                            "span": 1.0
                        }
                    },
                    {
                        "effect": "pulse",
                        "settings": {
                            "palette": "30c0ff",
                            "base_color": "000010",
                            "width": 0.18,
                            "travel": 1.4
                        }
                    },
                    {
                        "effect": "comet",
                        "seconds": 20,
                        "settings": {
                            "palette": "00ffaa",
                            "tail_pixels": 8,
                            "turn_ease": 1.0,
                            "mirror": 1
                        }
                    },
                    {
                        "effect": "orbit",
                        "settings": {
                            "palette": "1030ff,00d0ff,c080ff,ff40a0",
                            "pairs": 2,
                            "radius": 0.12,
                            "origin": 0.5
                        }
                    },
                    {
                        "effect": "silk",
                        "settings": {
                            "palette": "3a1078,c03080,ff9040,20b0c0,3a1078",
                            "fold": 0.5,
                            "sheen": 0.3
                        }
                    },
                    {
                        "effect": "ink",
                        "settings": {
                            "palette": "6a00ff,0080ff,00d0a0,ffb000,ff2060",
                            "period_seconds": 10,
                            "spread_seconds": 4
                        }
                    },
                    {
                        "effect": "caustics",
                        "settings": {
                            "palette": "020818,004060,00b0c0,a0fff0"
                        }
                    },
                    {
                        "effect": "shoreline",
                        "settings": {
                            "palette": "003048,00a090,60e0c0",
                            "foam_color": "ffffff",
                            "base_color": "000810",
                            "period_seconds": 6
                        }
                    },
                    {
                        "effect": "lava",
                        "settings": {
                            "palette": "021420,00805a,00d0a0,60ffd0",
                            "blobs": 4,
                            "radius": 0.12,
                            "speed": 3.0,
                            "color_span": 0.6,
                            "core": 1.5,
                            "white_hot": 0.8
                        }
                    },
                    {
                        "effect": "lava",
                        "settings": {
                            "palette": "1a0040,6a00ff,c040ff,ff40a0,4060ff",
                            "blobs": 6,
                            "radius": 0.22,
                            "speed": 3.5,
                            "color_speed": 0.7,
                            "color_span": 0.4,
                            "core": 2.2,
                            "white_hot": 1.2,
                            "min_brightness": 0.04
                        }
                    }
                ]
            }
        }
    ]
}
