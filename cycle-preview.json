{
    "_comment": "Throwaway preview config: cycles through every effect in order, 5s each, so they can be eyeballed in the virtual strip. Run: LED_PORT=none ./led cycle-preview.json cycle",

    "sinks": {
        "serial": { "port": "/dev/ttyUSB0", "baud": 921600 }
    },
    "strip": {
        "leds": 26,
        "pin": 13,
        "reverse": false,
        "brightness": 1.0,
        "gamma": "1.9 1.8 1.7",
        "white_balance": "b4ffff"
    },
    "transition_seconds": 0.6,
    "sensors": [
        "k10temp:Tctl",
        "nct6686:CPU",
        "nct6687:CPU",
        "nct6686:AMD TSI Addr 98h",
        "nct6683:AMD TSI Addr 98h",
        "nct6686"
    ],

    "period_seconds": 5,
    "order": "sequential",
    "effects": [
        { "effect": "breathe", "settings": { "palette": "0d4a44,30e090", "min_brightness": 0.05 } },
        { "effect": "aurora", "settings": { "palette": "10ff80,10a0ff,8040ff" } },
        { "effect": "drift", "settings": { "palette": "2858ff,30d0b0", "base_color": "000014", "blobs": 3, "width": 0.10 } },
        { "effect": "plasma", "settings": { "palette": "0040ff,00d0a0,c040ff,0040ff" } },
        { "effect": "lava", "settings": { "palette": "ff0050,ff5a00,ffd000,00e5ff,7a00ff,ff00d0", "blobs": 4, "radius": 0.2 } },
        { "effect": "tide", "settings": { "palette": "102060,1890d0,30d0a0,8040ff,102060", "span": 1.0 } },
        { "effect": "pulse", "settings": { "palette": "5028ff,30d0ff", "base_color": "000010", "width": 0.18, "travel": 1.4 } },
        { "effect": "comet", "seconds": 8, "settings": { "palette": "8040ff,30c0ff", "tail_pixels": 8, "turn_ease": 1.0, "mirror": 1 } },
        { "effect": "ember", "settings": { "palette": "2a0a00,ff7d1e", "min_brightness": 0.18 } },
        { "effect": "orbit", "settings": { "palette": "1030ff,00d0ff,c080ff,ff40a0", "pairs": 2, "radius": 0.12 } },
        { "effect": "silk", "settings": { "palette": "3a1078,c03080,ff9040,20b0c0,3a1078", "fold": 0.5, "sheen": 0.3 } },
        { "effect": "ink", "seconds": 15, "settings": { "palette": "6a00ff,0080ff,00d0a0,ffb000,ff2060", "period_seconds": 6, "spread_seconds": 3 } },
        { "effect": "caustics", "settings": { "palette": "020818,004060,00b0c0,a0fff0" } },
        { "effect": "shoreline", "seconds": 12, "settings": { "palette": "003048,00a090,60e0c0", "foam_color": "ffffff", "period_seconds": 5 } },
        { "effect": "rainbow" },
        { "effect": "load", "settings": { "smoothing_seconds": 0.7, "palette": "00e0c0,2060ff,a040ff,ff4060,ff9000" } },
        { "effect": "load_boil", "seconds": 10, "settings": { "smoothing_seconds": 0.7, "palette": "00e0c0,2060ff,a040ff,ff4060,ff9000" } },
        { "effect": "alarm", "settings": { "pulses_per_second": 2 } },
        { "effect": "steam_download" },
        { "effect": "boot", "seconds": 8, "settings": { "intro_seconds": 4, "color": "ffffff", "settle_seconds": 1.5, "settle_level": 0.05 } },
        { "effect": "shutdown", "seconds": 7, "settings": { "color": "0028ff", "duration_seconds": 5.0 } },
        { "effect": "button_on", "seconds": 6 },
        { "effect": "button_off", "seconds": 6 }
    ]
}
