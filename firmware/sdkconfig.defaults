# Non-default config baked into every build (idf.py merges this into the
# generated sdkconfig). Kept in git; the generated sdkconfig is not.

# Custom partition table — the recordings live on the LittleFS "storage"
# partition (see partitions.csv and main.cpp's esp_vfs_littlefs_register).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 4 MB flash, matching the partition layout.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# The host link owns the serial channel end to end (UART0 on the plain ESP32,
# USB Serial/JTAG on the C3). Disable the ESP-IDF console so log output can
# never inject stray bytes into the binary frame stream the daemon sends —
# and, on the C3, so the console doesn't fight our driver for the USB peripheral.
CONFIG_ESP_CONSOLE_NONE=y

# 1 kHz tick: recording replay paces frames as fast as ~16 ms, and the link
# read uses a couple-of-millisecond timeout to stay responsive without spinning.
CONFIG_FREERTOS_HZ=1000

# The receiver is small; optimize for size (it fits the factory app partition
# many times over, but there's no reason to carry the bulk).
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Bluetooth for the BLE power remote (ble.cpp): NimBLE host, the peripheral
# side only (we advertise + serve one GATT service; never scan, never
# connect out), one connection is plenty for a power button. Compiled into
# every image so the prebuilt-release flow keeps working; a board whose
# blecfg partition is erased never initializes the stack, so the cost of not
# opting in is flash, not RAM. On the plain ESP32 the controller runs
# BLE-only (no Classic BT).
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
