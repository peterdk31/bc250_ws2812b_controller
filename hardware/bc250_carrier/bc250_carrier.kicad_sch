  (text "ESP32-C3 Super Mini carrier for the BC-250 (serial_led_controller)."
    (at 20.32 20.32 0)
    (effects
      (font
        (size 1.27 1.27)
      )
      (justify left bottom)
    )
    (uuid "9e28d0a1-0065-4d7d-ab8b-bed20fd7a3c7")
  )
  (text "The Super Mini brings its own USB-C, 3.3 V regulator, BOOT/RESET buttons and GPIO8 LED."
    (at 20.32 24.13 0)
    (effects
      (font
        (size 1.27 1.27)
      )
      (justify left bottom)
    )
    (uuid "4c2b381e-3f35-4e25-84f9-78f0948c62eb")
  )
  (text "Its USB VBUS is tied to the 5V pin: cut the red wire in the USB cable (README, Power switch)."
    (at 20.32 27.94 0)
    (effects
      (font
        (size 1.27 1.27)
      )
      (justify left bottom)
    )
    (uuid "0a50da5f-482b-488f-89a7-a9af3994324b")
  )
  (text "Button pin 2 is a real GND: flash the power config with PWR_BUTTON_GND=-1."
    (at 20.32 31.75 0)
    (effects
      (font
        (size 1.27 1.27)
      )
      (justify left bottom)
    )
    (uuid "beb71b37-afb1-4b19-8816-e3206d3bf8e6")
  )
  (text "Fan header pin 1 = GND, 2 = +12 V, 3 = tach (unused), 4 = PWM. FAN1..4 = FAN_PINS=5,6,7,10."
    (at 20.32 35.56 0)
    (effects
      (font
        (size 1.27 1.27)
      )
      (justify left bottom)
    )
    (uuid "49b9bc35-08e3-406a-aa44-6aa89ecea7ec")
  )
  (text "J1 takes the FSP500-30AS 10-pin Mini-Fit Jr plug; pin map per its pinout drawing (see README)."
    (at 20.32 39.37 0)
    (effects
      (font
        (size 1.27 1.27)
      )
      (justify left bottom)
    )
    (uuid "6745f7aa-c1f5-45a3-871c-4eb7702ca2a2")
  )
  (text "VIN is the strip supply rail (3.3 V from the PSU), separate from 5VSB; the strip path is sized for 3 A."
    (at 20.32 43.18 0)
    (effects
      (font
        (size 1.27 1.27)
      )
      (justify left bottom)
    )
    (uuid "d21a96cc-8668-45d0-87ff-39d4bb1dff2a")
  )
  (text "Mounting holes, M3:"
    (at 20.32 163.83 0)
    (effects
      (font
        (size 1.27 1.27)
      )
      (justify left bottom)
    )
    (uuid "de25508f-cb95-488a-ba30-52c0cebfe7fc")
  )
  (sheet_instances
    (path "/"
      (page "1")
    )
  )
)
