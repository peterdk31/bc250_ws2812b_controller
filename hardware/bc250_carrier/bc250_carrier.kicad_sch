  (text "ESP32-C3 Super Mini carrier for the BC-250 (serial_led_controller)."
    (at 20.32 20.32 0)
    (effects
      (font
        (size 1.27 1.27)
      )
      (justify left bottom)
    )
    (uuid "9cf5d8d7-ff0a-402b-bc32-a01b3ff7f680")
  )
  (text "The Super Mini brings its own USB-C, 3.3 V regulator, BOOT/RESET buttons and GPIO8 LED."
    (at 20.32 24.13 0)
    (effects
      (font
        (size 1.27 1.27)
      )
      (justify left bottom)
    )
    (uuid "f748bf57-c51e-49be-bc6e-94c5153965dc")
  )
  (text "Its USB VBUS is tied to the 5V pin: cut the red wire in the USB cable (README, Power switch)."
    (at 20.32 27.94 0)
    (effects
      (font
        (size 1.27 1.27)
      )
      (justify left bottom)
    )
    (uuid "937938e1-6a09-4e2c-b032-18e23a15fd0f")
  )
  (text "Button pin 2 is a real GND: flash the power config with PWR_BUTTON_GND=-1."
    (at 20.32 31.75 0)
    (effects
      (font
        (size 1.27 1.27)
      )
      (justify left bottom)
    )
    (uuid "4553b4e1-a761-41bf-b0ab-4888977a5194")
  )
  (text "Fan header pin 1 = GND, 2 = +12 V, 3 = tach (unused), 4 = PWM. FAN1..4 = FAN_PINS=5,6,7,10."
    (at 20.32 35.56 0)
    (effects
      (font
        (size 1.27 1.27)
      )
      (justify left bottom)
    )
    (uuid "f9063b47-6d29-40a7-97ad-79ce7ade680f")
  )
  (text "J1 takes the FSP500-30AS 10-pin Mini-Fit Jr plug; pin map per its pinout drawing (see README)."
    (at 20.32 39.37 0)
    (effects
      (font
        (size 1.27 1.27)
      )
